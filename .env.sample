# =============================================================================
# voiceai — environment for the single app (`uvicorn voiceai.app:app`, spec 0048)
#
# Copy to `.env`. Every variable in the "single app" sections below is declared
# and typed in voiceai/core/environment.py (AGENTS.md rule 4) — the app reads
# nothing else from the process environment. Boolean knobs accept 1/0,
# true/false, yes/no, on/off.
#
# Two readers share this file: python-dotenv (local `uvicorn`, make targets) and
# Docker Compose `env_file`. Comments stay on their own line so both agree.
# =============================================================================

# ---- Process -----------------------------------------------------------------
# dev | staging | prod. `prod` turns the Secure cookie flag on (see COOKIE_SECURE).
APP_ENV=dev
LOG_LEVEL=INFO

# ---- System of record: MongoDB Atlas (required) --------------------------------
# memory | mongo. `mongo` is the only production value. `memory` is a throwaway
# in-process store for local experiments and tests (everything vanishes on
# restart) and needs no URL.
DB_BACKEND=mongo
# Atlas connection string, e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Required when DB_BACKEND=mongo: the process refuses to boot without it.
# Local MongoDB from docker-compose (`--profile mongo`): mongodb://mongo:27017
MONGO_URL=
# Legacy alias of MONGO_URL, read only when MONGO_URL is empty. Leave blank.
DB_URL=
DB_NAME=otoba

# ---- Voice websocket -----------------------------------------------------------
# The realtime call route `WS /api/v1/chat/v1/{agent_id}` is flag-gated: with
# false the handler closes every socket immediately (dark). Set true in every
# deployment that takes calls.
VOICE_WS_ENABLED=true

# ---- Login sessions: RS256 JWT access tokens + rotating refresh tokens ---------
# Both keys set (PEM text) or both empty. One of the pair alone refuses boot;
# both empty keeps token issuance dark (signup/login answer "Token pair
# issuance is not configured"). Generate a pair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl pkey -in jwt.key -pubout -out jwt.pub
# python-dotenv (local uvicorn): paste the PEM inside double quotes, real newlines.
# Docker Compose env_file / --env-file: one line, newlines written as \n — the
# loader decodes them (JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Token claims and lifetimes in seconds; refresh must exceed access.
JWT_ISSUER=otobaai
JWT_AUDIENCE=otobaai-api
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000

# ---- Browser clients: CORS + session cookie --------------------------------------
# Comma-separated EXACT origins (scheme://host[:port]) the UI is served from.
# No wildcard, no path — an invalid entry refuses boot. Empty disables CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://obotaai-ui.vercel.app
# Secure cookie flag: empty follows APP_ENV (on in prod), 1/0 forces it.
COOKIE_SECURE=
# Cookie Domain (empty = host-only) and SameSite (lax | strict | none).
# A UI on another site (Vercel UI -> API host) needs COOKIE_SAMESITE=none AND COOKIE_SECURE=1.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# ---- Redis: OPTIONAL TTL cache (login throttle, JWT denylist) --------------------
# Spec 0048: Redis is not a database any more — agents, prompts and every
# platform row live in Atlas. Empty runs the app without Redis: the login
# throttle falls back to the in-process limiter, the denylist reads the store,
# /api/v1/health/ready reports redis as skipped. Set it in any multi-worker
# deployment so throttle/denylist are shared: Upstash `rediss://...`, or the
# compose service `redis://redis:6379` (started with `docker compose --profile cache up`).
REDIS_CACHE_URL=
# Legacy single URL: only a fallback for the three isolated URLs, including the
# cache client that /api/v1/health/ready probes. Not required.
REDIS_URL=
# Celery broker / result backend for the future jobs worker (spec 0018 M6/M9).
# Nothing reads them today; leave empty.
REDIS_BROKER_URL=
REDIS_RESULT_URL=

# ---- Telephony as seen by the app ---------------------------------------------------
# Twilio auth token: validates the signature on POST /api/v1/voice/inbound/twilio
# (spec 0047). Empty fails closed — every inbound call is rejected.
TWILIO_AUTH_TOKEN=
# talko-service deployment the outbound bridge dials through (spec 0009).
# Empty means outbound Talko features use per-request/per-record values only.
TALKO_SERVICE_BASE_URL=

# ---- Blob store: prompts/audio/KB binaries (replaces the agent_data/ directory) ------
# Empty disables the uploader.
BLOB_STORE_URL=
BLOB_BUCKET=
BLOB_REGION=ap-south-1

# =============================================================================
# Provider keys — read by the voice engine's ASR/LLM/TTS providers (`os.getenv`
# inside the provider adapters), not by core/environment.py. Fill the ones your
# agents use; README.md "Using your own providers" lists the rest.
# =============================================================================
DEEPGRAM_AUTH_TOKEN=
SONIOX_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_MODEL=gemini-3.6-flash

# =============================================================================
# Example telephony trunks (local_setup/telephony_server/*.py; docker-compose
# services twilio-app / plivo-app / talko-app). Each reads only its own block
# via os.getenv and none of them uses Redis.
# =============================================================================
# Twilio/Plivo trunks: the answer callback mints the single-use websocket ticket
# from voiceai-app and points the carrier <Stream> at
# wss://<voiceai-app tunnel>/api/v1/chat/v1/{agent_id}?ticket=... (spec 0021).
# VOICEAI_API_KEY is an API key with the calls:write scope (POST /api/v1/api-keys);
# VOICEAI_INTERNAL_URL is the app as reachable from the trunk container.
VOICEAI_API_KEY=
VOICEAI_INTERNAL_URL=http://voiceai-app:5001
# ngrok service (docker-compose): the agent reads its authtoken from this
# variable; local_setup/ngrok-config.yml only defines the tunnels.
NGROK_AUTHTOKEN=

# twilio_api_server.py — plus TWILIO_AUTH_TOKEN above (shared with the app).
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=

# plivo_api_server.py
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# talko_api_server.py — Talko trunk: talko-service places Tata Tele calls and
# relays media to the app's websocket. TALKO_API_BASE_URL is the trunk's knob;
# TALKO_SERVICE_BASE_URL above is the app's.
TALKO_API_BASE_URL=http://talko-service:8003/talko-service/v1
TALKO_API_KEY=
TALKO_AI_DID=
TALKO_PARTNER_ID=
