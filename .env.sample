DEEPGRAM_AUTH_TOKEN=
SONIOX_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_MODEL=gemini-3.6-flash
REDIS_URL=redis://redis:6379

# Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# Plivo credentials
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# Engine <-> telephony trust. Required for real phone calls: carrier media streams (Twilio,
# Plivo, the Talko relay) cannot carry a login cookie, so the telephony servers sign the
# stream URL with this secret and the engine verifies it. Use the same value everywhere
# (16+ random characters). Mint a static relay token with:
#   python -m voiceai.platform.stream_token --agent '*' --ttl 0
VOICE_STREAM_SECRET=
# Comma-separated key(s) callers must send as X-API-Key to the dial endpoints
# (POST /call, POST /talko/call). Empty = open, local development only.
TELEPHONY_API_KEY=
# 1 = verify Twilio/Plivo webhook signatures on the connect callbacks.
CARRIER_VALIDATE_SIGNATURES=0
# 1 = refuse websocket calls whose stored config no longer matches the current schema
# (engine-level checks such as unknown providers are always enforced).
AGENT_CONFIG_STRICT=0

# Talko trunk (talko-service places Tata Tele calls, relays media here)
TALKO_API_BASE_URL=http://talko-service:8003/talko-service/v1
TALKO_API_KEY=
TALKO_AI_DID=
TALKO_PARTNER_ID=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://obotaai-ui.vercel.app

# WB-1 in-app warm socket pool (Sarvam TTS/STT standbys). Off (0) = today's
# direct-dial behavior. The pool is per-process: run uvicorn --workers 1.
WARM_POOL_ENABLED=0
# Standbys kept per voice key (model,speaker,lang,rate,codec / model,lang,mode,VAD).
WARM_POOL_MAX_PER_VOICE=2
# Global caps sized for Sarvam Starter (STT << 20, TTS bulbul:v3 << 30).
WARM_POOL_MAX_GLOBAL_TTS=16
WARM_POOL_MAX_GLOBAL_STT=8
# Keeper ping cadence (<60s) and idle-standby rotation age.
WARM_POOL_HEALTHCHECK_S=20
WARM_POOL_IDLE_TTL_S=45
# Minimum gap between standby opens (stagger) to avoid dial bursts.
WARM_POOL_STAGGER_S=0.3

# WB-2 welcome fast path: pre-render greetings at lifespan + agent save/update
# so calls send cached bytes immediately (miss = live synthesis as today).
WELCOME_PRELOAD_ENABLED=1

# WB-3c S2S talk-despite-silence: 1 = turns close on EOS/sentinel via the
# playout estimate while total_missed>0 is logged (mark silence never mutes).
S2S_ACK_INDEPENDENT=1
# Expected Talko caller-leg encoding verified on ingest (rescue still forwards).
S2S_TALKO_ENCODING=mulaw-8k