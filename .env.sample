DEEPGRAM_AUTH_TOKEN=
SONIOX_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_MODEL=gemini-3.6-flash
REDIS_URL=redis://redis:6379

# Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# Plivo credentials
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# Talko trunk (talko-service places Tata Tele calls, relays media here)
TALKO_API_BASE_URL=http://talko-service:8003/talko-service/v1
TALKO_API_KEY=
TALKO_AI_DID=
TALKO_PARTNER_ID=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://obotaai-ui.vercel.app

# ---- New architecture (core/environment.py — spec 0001) ----------------------
# Every variable below is declared and typed in voiceai/core/environment.py;
# os.getenv anywhere else is a contract violation (AGENTS.md rule 4).
APP_ENV=dev                 # dev | staging | prod
LOG_LEVEL=INFO
DB_BACKEND=memory           # memory | mongo (mongo driver: spec 0003, needs DB_URL)
DB_URL=                       # e.g. mongodb://localhost:27017 (local mongo service below)
DB_NAME=otoba
# Leave unset to follow APP_ENV (secure cookies on in prod); set 1/0 to force.
COOKIE_SECURE=
# Cutover flag for the new-architecture voice WS route (spec 0004 B14); 0 keeps it dark.
VOICE_WS_ENABLED=0

# ---- Greenfield base (T0: Mongo truth, Redis cache-only) -----------------------
# System of record (Atlas). MONGO_URL wins over DB_URL when both are set.
MONGO_URL=
# Isolated Redis URLs (three SEPARATE databases — Upstash has no SELECT).
# Each falls back to REDIS_URL when empty; production sets all three.
REDIS_CACHE_URL=
REDIS_BROKER_URL=
REDIS_RESULT_URL=
# Cookie domain (empty = host-only) and SameSite; 'none' mandates COOKIE_SECURE=1.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
# Stateless JWT sessions (access + opaque refresh). Both keys set (PEM text) or
# both empty (JWT flows stay dark); TTLs in seconds, refresh must exceed access.
JWT_ISSUER=otobaai
JWT_AUDIENCE=otobaai-api
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Blob store for prompts/audio/KB binaries (replaces agent_data/ in T3).
BLOB_STORE_URL=
BLOB_BUCKET=
BLOB_REGION=ap-south-1