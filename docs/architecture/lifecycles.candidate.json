  "cards": [
    {
      "dot": "emerald",
      "title": "Happy Path",
      "items": [
        "Client → Middleware → Controller → Service → Repository → Database → Response",
        "Every response is wrapped in success_response() envelope with error_id on failure",
        "Auth runs before any service call — denied writes never reach the store"
      ]
    },
    {
      "dot": "rose",
      "title": "Error Handling",
      "items": [
        "Unexpected exceptions become 500 envelopes in middleware — never leak str(exc)",
        "Clients get error_id + code; logs get the stack trace",
        "CORS headers are applied even on error responses"
      ]
    }
  ]
