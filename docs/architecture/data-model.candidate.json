      "items": [
        "id: storage identifier (None until insert)",
        "tenant_id: isolation boundary (None = pre-tenancy row)",
        "created_at / updated_at: timezone-aware UTC timestamps",
        "is_active: soft delete — no row is ever destroyed",
        "meta: free-form, non-indexed extras"
      ]
