  "cards": [
    {
      "dot": "rose",
      "title": "Trust Boundary",
      "items": [
        "Everything inside the security-group is server-side and trusted",
        "Client → Middleware is the only entry point (HTTPS + CORS)",
        "Persistence (MongoDB, Redis) is outside the trust boundary — accessed only through the vault"
      ]
    },
    {
      "dot": "amber",
      "title": "Security Controls",
      "items": [
        "AuthService: session tokens, JWT, API keys — never trust client-supplied identity",
        "TenantContext: tenant_id always from server-side context, never query/body",
        "CredentialVault: AES-GCM sealing — secrets never stored in plaintext",
        "SSRF Guard: is_safe_outbound_url blocks private/link-local/metadata ranges"
      ]
    }
  ]
